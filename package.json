{
  "name": "lokal-music",
  "version": "8.7.5",
  "description": "Local-first music player built w/ Electron and React. Designed for people with large local music libraries who'd like a modern listening experience w/o the burdens of streaming subscriptions.",
  "author": "sipbuu <97703296+sipbuu@users.noreply.github.com>",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:web": "concurrently \"vite\" \"node server/start.js\"",
    "build": "vite build && npm run native:prepare && electron-builder",
    "server": "node server/start.js",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "rebuild:electron": "electron-rebuild",
    "rebuild:web": "npm rebuild better-sqlite3",
    "postinstall": "electron-builder install-app-deps && npm run native:prepare",
    "native:prepare": "node scripts/prepare-native.js"
  },
  "build": {
    "appId": "com.lokal.music",
    "productName": "Lokal",
    "icon": "public/lokal-icon.ico",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "server/**/*",
      "public/remote.html",
      "public/remote-manifest.json",
      "public/remote-sw.js",
      "public/lokal-icon.png"
    ],
    "extraResources": [
      { "from": "public/remote.html", "to": "public/remote.html" },
      { "from": "public/remote-manifest.json", "to": "public/remote-manifest.json" },
      { "from": "public/remote-sw.js", "to": "public/remote-sw.js" },
      { "from": "public/lokal-icon.png", "to": "public/lokal-icon.png" }
    ],
    "asar": true,
    "asarUnpack": [
      "electron/native/**/*.node"
    ],
    "publish": {
      "provider": "github",
      "owner": "sipbuu",
      "repo": "lokal"
    },
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "public/lokal-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "fileAssociations": [
        {
          "ext": [
            "mp3",
            "flac",
            "m4a",
            "ogg",
            "wav",
            "aac",
            "opus",
            "wma",
            "alac",
            "ape"
          ],
          "name": "Audio File",
          "description": "Audio File",
          "role": "Viewer",
          "icon": "public/lokal-icon.ico"
        }
      ],
      "extraResources": [
        {
          "from": "build/webview2-signin",
          "to": "webview2-signin",
          "filter": [
            "**/*",
            "!*.pdb"
          ]
        }
      ]
    },
    "mac": {
      "icon": "public/lokal-icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category-music"
    },
    "linux": {
      "icon": "public/lokal-icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Music",
      "maintainer": "sipbuu <97703296+sipbuu@users.noreply.github.com>"
    }
  },
  "dependencies": {
    "@puppeteer/browsers": "^3.2.3",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "bgutils-js": "^4.0.3",
    "cors": "^2.8.5",
    "discord-rpc": "^4.0.1",
    "dotenv": "^16.4.5",
    "egoroof-blowfish": "4.0.2",
    "electron-log": "^5.4.3",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9",
    "express": "^4.18.3",
    "fs-extra": "^11.3.3",
    "multicast-dns": "^7.2.5",
    "music-metadata": "^12.0.0",
    "node-taglib-sharp": "^6.0.3",
    "quickjs-emscripten": "0.32.0",
    "sharp": "^0.35.5",
    "tough-cookie": "6.0.0",
    "yauzl": "^3.4.0",
    "youtubei.js": "^17.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@electron/rebuild": "^4.2.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^8.2.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "framer-motion": "^11.0.8",
    "lucide-react": "^1.52.0",
    "node-gyp": "12.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "wait-on": "^7.2.0",
    "zustand": "^4.5.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "qs": "^6.16.0",
    "uuid": "^11.1.1"
  }
}
